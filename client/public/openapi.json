                    "type": "string",
                    "maxLength": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns deviceId, secret, otpauthUrl, qrDataUrl"
          }
        }
      }
    },
    "/api/auth/2fa/confirm": {
      "post": {
        "tags": [
          "Auth",
          "2FA"
        ],
        "summary": "Confirm TOTP device",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "deviceId",
                  "code"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device activated"
          }
        }
      }
    },
    "/api/auth/2fa/remove": {
      "post": {
        "tags": [
          "Auth",
          "2FA"
        ],
        "summary": "Remove TOTP device",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "deviceId",
                  "code"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device removed"
          }
        }
      }
    },
    "/api/auth/2fa/verify": {
      "post": {
        "tags": [
          "Auth",
