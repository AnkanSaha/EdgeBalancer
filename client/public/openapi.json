    "/api/loadbalancers/validate-hostname": {
      "post": {
        "tags": [
          "Load Balancers"
        ],
        "summary": "Preflight hostname check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "domain"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
